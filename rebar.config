%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_warden.
%%
%% Deceptive threshold guard: senses intrusion attempts on a public box and reports them to the threat commons
%%

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. No store: the service module
    %% exports no store_id/0 + data_dir/0. 0.27 labels the boot claim with
    %% MCL_SERVICE_NAME / MCL_BOX, which the realm's Providers desk shows.
    %% 0.28 answers `Org/info' for the service and is the release macula 12.2
    %% needs: under 12.2 an older mcl_om lets a failed publish announcement
    %% kill the publishing process.
    {mcl_om, "~> 0.28"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The facts module and the service call `macula' directly, but macula comes in
%% only through mcl_om, so it is not in the PLT unless it is named here:
%% dialyzer would report every macula call as unknown.
{dialyzer, [{plt_extra_apps, [macula]}]}.

{relx, [
    {release, {mcl_warden, "0.1.0"}, [mcl_warden, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
