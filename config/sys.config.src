%% Substituted by relx at boot; every ${VAR} must resolve or the node will not
%% start with a malformed term. That is the correct failure: a service with a
%% half-configured realm announces itself where nobody can attribute it, which
%% looks exactly like a healthy node.
[
    {mcl_warden, [
        %% The realm NAME the topics carry (io.macula), where MCL_REALM below is
        %% its sha256 tag. The service refuses to start unless they agree: a
        %% topic naming one realm published in another reaches nobody.
        {realm_name,       "${MCL_REALM_NAME}"},
        %% WHO operates this warden, and WHERE it runs. Display attribution on
        %% every fact, self-asserted; empty means unset and the key is omitted.
        %% The verified sender is the node identity, not these.
        {tenant_id,        "${MCL_WARDEN_TENANT_ID}"},
        {label,            "${MCL_WARDEN_LABEL}"},
        %% Declared coordinates, integer micro-degrees ("60170000"), carried on
        %% the check-in. Self-asserted. Empty means no map marker.
        {lat_e6,           "${MCL_WARDEN_LAT_E6}"},
        {lng_e6,           "${MCL_WARDEN_LNG_E6}"},
        %% Decoy ports as an Erlang list literal, e.g. [2222,2323]. [] is
        %% sensing-only and opens nothing. Never the real sshd port.
        {tarpit_ports,     ${MCL_WARDEN_TARPIT_PORTS}},
        {tarpit_max_conns, ${MCL_WARDEN_MAX_CONNS}},
        %% The host's auth log inside the container. Mount the DIRECTORY, not
        %% the file: a file bind-mount pins the inode and the sensor goes blind
        %% at the first logrotate.
        {auth_log,         "${MCL_WARDEN_AUTH_LOG}"}
    ]},
    {mcl_om, [
        %% Without this, mcl_om_identity:load_node_key/0 returns `undefined'
        %% forever and identity_key/0 stays {error, no_identity_key} -- a
        %% service that declares a handler-bearing capability() then silently
        %% never advertises it, on every republish tick, permanently ("an
        %% ephemeral service cannot sign and is correctly not advertised",
        %% mcl_om_capabilities's own moduledoc). Confirmed live 2026-08-31
        %% on a service generated from an earlier copy of this template that
        %% lacked this line. Point it at the mounted secrets volume.
        %% ⚠ ON A PERSISTENT VOLUME. This key IS the warden's identity on the
        %% mesh: every fact is delivered with it as the verified publisher, and
        %% a consumer attributes and allowlists wardens by it. A container
        %% recreate without the volume mints a new one, and the warden becomes
        %% a stranger to everyone who knew it.
        {identity_key_path, "/etc/mcl/secrets/identity.key"},
        {health_port,       ${MCL_HEALTH_PORT}},
        {capability_topic,  <<"_mesh.cap.">>},
        %% One org per service, named after the repo, and the same org the
        %% fact topics are owned by. Fixed, not deploy config.
        {org,               <<"mcl-warden">>},
        %% Informational labels on the realm's provider row (never trusted).
        {service_name,      <<"mcl-warden">>},
        {box,               <<"${MCL_WARDEN_LABEL}">>},
        %% THE REALM IS AN APPLICATION ENV, NOT A SHELL VARIABLE, and this file
        %% is the only place the two meet. mcl_om_identity:realm() reads
        %% application:get_env(mcl_om, realm); exporting MCL_REALM in the
        %% shell and expecting that to be enough has cost a sibling service an
        %% hour, because nothing translates between the two by itself.
        {realm,             <<"${MCL_REALM}">>},
        %% ⚠ THE TRUST ANCHOR, AND IT IS NOT OPTIONAL. MCL_REALM above is an
        %% IDENTIFIER (sha256 of the realm name); this is the realm's public
        %% SIGNING KEY, 64-hex-per-32-bytes, as carried. mcl_om decodes it and
        %% pins it as macula:connect/2's `realm_trust'.
        %%
        %% Without it every org-namespaced advertisement this service resolves
        %% is refused with `no_realm_key', direct dial answers `{unresolved,
        %% no_trusted_advertisement}', and the boot claim never reaches the
        %% realm: no pending row, no delegation, nothing callable. The node
        %% stays green and answers /health throughout, which is why mcl_om
        %% now refuses to start a pool without it rather than letting a
        %% service look healthy and be unreachable.
        %%
        %% Public material. It is the half everyone verifies against, not a
        %% secret, and it does not belong in the secrets volume.
        %%
        %% An earlier version of this file said the realm's key comes from a
        %% `foundation_realm_trust_list' DHT record rather than from here.
        %% That is WRONG for this path and cost a deployment: `macula_direct_dial'
        %% never supplies the foundation form, so the pinned key is the only
        %% way an advertisement is ever trusted.
        {realm_key,         <<"${MCL_REALM_KEY}">>}
    ]},
    %% ==========================================================================
    %% THE PQ CRYPTO PROFILE, WITHOUT WHICH THIS NODE DOES NOT PEER
    %% ==========================================================================
    %%
    %% ⚠ MANDATORY. The macula app starts before the service reads anything,
    %% and without this block it boots on the classical profile while every
    %% PQ station closes the CONNECT/HELLO handshake as puzzle_invalid --
    %% forever, silently. The 11.x client model: a puzzle-8 identity key
    %% (generated and persisted by mcl_om_identity when the path above is
    %% missing) and the pq_hybrid crypto profile every wire signature is
    %% checked under. mcl_om is a library; each service's own release
    %% carries this.
    %%
    %% ⚠ NO `puzzle_difficulty' HERE. macula 12 (D30) makes it one
    %% constant for the fleet, `macula_node_keys:puzzle_difficulty()',
    %% and REFUSES a `{macula, puzzle_difficulty, _}' setting at
    %% application start whatever the value: a node that set one would
    %% believe it had chosen a difficulty that nothing reads.
    {macula, [
        {crypto_profile, pq_hybrid}
    ]},
    {kernel, [{logger_level, info}]}
].
